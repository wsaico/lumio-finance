# Supabase (público — mismo proyecto que la web app)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend unificado Lumio (Next.js API)
# En producción usa https://lumio.esaico.com; en desarrollo local usa http://<TU_IP_LAN>:3000
EXPO_PUBLIC_API_BASE_URL=https://lumio.esaico.com

# Longitud del código OTP de verificación de correo
EXPO_PUBLIC_OTP_LENGTH=6
