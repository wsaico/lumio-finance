# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# App URL
NEXT_PUBLIC_SITE_URL=https://lumio.esaico.com

# Gemini / AI
GEMINI_API_KEY=your-gemini-api-key

# Transactional Email Provider (BREVO | RESEND | SENDGRID | SMTP | WEBHOOK)
EMAIL_PROVIDER=BREVO
EMAIL_FROM="Lumio Finance <no-reply@esaico.com>"
EMAIL_REPLY_TO=willysaico@gmail.com

# Provider API Keys / Credentials (can also be configured from /dashboard/admin)
BREVO_API_KEY=xkeysib-your-brevo-api-key
RESEND_API_KEY=re_your-resend-api-key
SENDGRID_API_KEY=SG.your-sendgrid-api-key

# Custom SMTP (used when EMAIL_PROVIDER=SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-login
SMTP_PASS=xsmtpsib-your-smtp-password

# Webhook Transport (used when EMAIL_PROVIDER=WEBHOOK)
SMTP_WEBHOOK_URL=https://your-webhook-endpoint.example.com/email
SMTP_WEBHOOK_SECRET=your-webhook-secret

# Optional dedicated encryption key for email_settings in DB (falls back to SUPABASE_SERVICE_ROLE_KEY)
EMAIL_SETTINGS_ENCRYPTION_KEY=

# Supabase Management CLI / scripts/sync-supabase-emails.mjs (--push / --push-smtp)
SUPABASE_ACCESS_TOKEN=sbp_your-supabase-access-token
BREVO_SMTP_USER=your-brevo-smtp-login
BREVO_SMTP_PASS=xsmtpsib-your-brevo-smtp-password
