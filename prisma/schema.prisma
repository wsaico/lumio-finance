generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User Profile (linked to Supabase Auth)
model Profile {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // User Settings
  defaultCurrency String  @default("USD") @map("default_currency") @db.VarChar(3)
  theme           String? @db.VarChar(50)
  language        String  @default("es") @db.VarChar(10)
  budgetingMethod String? @map("budgeting_method") // 'TRADITIONAL' | '50_30_20'

  // Dashboard customization
  dashboardConfig Json? @map("dashboard_config") @db.JsonB

  // Relations
  expenseCategories     ExpenseCategory[]
  incomeCategories      IncomeCategory[]
  accounts              Account[]
  transactions          Transaction[]
  budgets               Budget[]
  savingsGoals          SavingsGoal[]
  loans                 Loan[]
  creditCards           CreditCard[]
  creditCardStatements  CreditCardStatement[]
  recurringRules        RecurringRule[]
  liquidations          Liquidation[]
  pettyCashFunds        PettyCashFund[]
  pettyCashExpenses     PettyCashExpense[]
  pettyCashSettlements  PettyCashSettlement[]
  pettyCashReplenishments PettyCashReplenishment[]
  pettyCashAudits       PettyCashAudit[]
  pettyCashTransfers    PettyCashTransfer[]
  categoryLearning      CategoryLearning[]
  googleToken           GoogleToken?

  @@map("profiles")
}

// Expense Categories
model ExpenseCategory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(100)
  icon      String   @db.VarChar(50)
  color     String   @db.VarChar(20)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  budgetRule String? @default("WANT") @map("budget_rule") // 'NEED' | 'WANT' | 'SAVINGS'
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user              Profile            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  budgets           Budget[]
  subcategories     Subcategory[]
  recurringRules    RecurringRule[]
  pettyCashExpenses PettyCashExpense[]
  categoryLearning  CategoryLearning[]

  @@index([userId])
  @@map("expense_categories")
}

// Income Categories
model IncomeCategory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(100)
  icon      String   @db.VarChar(50)
  color     String   @db.VarChar(20)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  subcategories  Subcategory[]
  recurringRules RecurringRule[]

  @@index([userId])
  @@map("income_categories")
}

// Subcategories (for both Expense and Income)
model Subcategory {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  expenseCategoryId String?          @map("expense_category_id") @db.Uuid
  incomeCategoryId  String?          @map("income_category_id") @db.Uuid
  expenseCategory   ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id], onDelete: Cascade)
  incomeCategory    IncomeCategory?  @relation(fields: [incomeCategoryId], references: [id], onDelete: Cascade)

  transactions   Transaction[]
  recurringRules RecurringRule[]

  @@index([expenseCategoryId])
  @@index([incomeCategoryId])
  @@map("subcategories")
}

// Accounts
model Account {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  name             String   @db.VarChar(100)
  accountType      String   @map("account_type") @db.VarChar(50)
  currencyCode     String   @map("currency_code") @db.VarChar(3)
  initialBalance   Decimal  @default(0) @map("initial_balance") @db.Decimal(15, 2)
  currentBalance   Decimal  @default(0) @map("current_balance") @db.Decimal(15, 2)
  color            String   @default("#0ea5e9") @db.VarChar(20)
  icon             String   @default("wallet") @db.VarChar(50)
  isActive         Boolean  @default(true) @map("is_active")
  sortOrder        Int      @default(0) @map("sort_order")
  fixedFundAmount  Decimal? @map("fixed_fund_amount") @db.Decimal(15, 2)

  // Credit Card specific fields (only for accountType = CREDIT_CARD)
  lastFourDigits        String?  @map("last_four_digits") @db.VarChar(4)
  creditLimit           Decimal? @map("credit_limit") @db.Decimal(15, 2)
  usedBalance           Decimal? @default(0) @map("used_balance") @db.Decimal(15, 2)
  closingDay            Int?     @map("closing_day")
  paymentDueDay         Int?     @map("payment_due_day")
  cardNetwork           String?  @map("card_network") @db.VarChar(20)
  expiryDate            DateTime? @map("expiry_date") @db.Timestamptz(6)
  interestRateAnnual    Decimal? @map("interest_rate_annual") @db.Decimal(5, 2)
  interestRateMonthly   Decimal? @map("interest_rate_monthly") @db.Decimal(5, 2)
  minPaymentPercent     Decimal? @default(5) @map("min_payment_percent") @db.Decimal(5, 2)
  minPaymentAbsolute    Decimal? @map("min_payment_absolute") @db.Decimal(15, 2)

  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                  Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]  @relation("AccountTransactions")
  transferTransactions  Transaction[]  @relation("TransferToAccount")
  savingsGoals          SavingsGoal[]
  recurringRules        RecurringRule[]
  creditCards           CreditCard[]
  pettyCashFunds        PettyCashFund[]

  @@index([userId])
  @@map("accounts")
}

// Transactions
model Transaction {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  accountId       String   @map("account_id") @db.Uuid
  transactionType String   @map("transaction_type") @db.VarChar(50)
  amount          Decimal  @db.Decimal(15, 2)
  transactionDate DateTime @map("transaction_date") @db.Timestamptz(6)
  description     String?  @db.VarChar(255)
  notes           String?  @db.Text
  metadata        Json?    @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  expenseCategoryId   String?  @map("expense_category_id") @db.Uuid
  incomeCategoryId    String?  @map("income_category_id") @db.Uuid
  subcategoryId       String?  @map("subcategory_id") @db.Uuid
  transferToAccountId String?  @map("transfer_to_account_id") @db.Uuid
  savingsGoalId       String?  @map("savings_goal_id") @db.Uuid
  loanId              String?  @map("loan_id") @db.Uuid
  creditCardId        String?  @map("credit_card_id") @db.Uuid
  recurringRuleId     String?  @map("recurring_rule_id") @db.Uuid
  attachmentUrl       String?  @map("attachment_url") @db.Text

  // Multi-currency support
  originalAmount   Decimal? @map("original_amount") @db.Decimal(15, 2)
  originalCurrency String?  @map("original_currency") @db.VarChar(3)
  exchangeRate     Decimal? @map("exchange_rate") @db.Decimal(18, 8)

  user              Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account           Account          @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  expenseCategory   ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id], onDelete: SetNull)
  incomeCategory    IncomeCategory?  @relation(fields: [incomeCategoryId], references: [id], onDelete: SetNull)
  subcategory       Subcategory?     @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  transferToAccount Account?         @relation("TransferToAccount", fields: [transferToAccountId], references: [id], onDelete: SetNull)
  savingsGoal       SavingsGoal?     @relation(fields: [savingsGoalId], references: [id], onDelete: SetNull)
  loan              Loan?            @relation(fields: [loanId], references: [id], onDelete: SetNull)
  creditCard        CreditCard?      @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  recurringRule     RecurringRule?   @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([accountId])
  @@index([transactionDate])
  @@index([creditCardId])
  @@map("transactions")
}

// Budgets
model Budget {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  categoryId String?  @map("category_id") @db.Uuid
  name       String   @db.VarChar(200)
  amount     Decimal  @db.Decimal(15, 2)

  // Flexible periods
  periodType String   @default("MONTHLY") @map("period_type") @db.VarChar(20)
  startDate  DateTime @map("start_date") @db.Timestamptz(6)
  endDate    DateTime @map("end_date") @db.Timestamptz(6)

  // Legacy fields (for backward compatibility)
  month      Int?
  year       Int?
  spent      Decimal  @default(0) @db.Decimal(15, 2)

  // Advanced configuration
  rollover      Boolean  @default(false)
  notifyAt      Decimal? @default(80) @map("notify_at") @db.Decimal(5, 2)
  categoryLimits Json?   @map("category_limits") @db.JsonB
  isPinned      Boolean  @default(false) @map("is_pinned")
  isActive      Boolean  @default(true) @map("is_active")

  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([startDate, endDate])
  @@map("budgets")
}

// Savings Goals
model SavingsGoal {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  accountId     String   @map("account_id") @db.Uuid
  name          String   @db.VarChar(100)
  targetAmount  Decimal  @map("target_amount") @db.Decimal(15, 2)
  currentAmount Decimal  @default(0) @map("current_amount") @db.Decimal(15, 2)
  targetDate    DateTime @map("target_date") @db.Timestamptz(6)
  isCompleted   Boolean  @default(false) @map("is_completed")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@map("savings_goals")
}

// Loans
model Loan {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  loanType     String   @map("loan_type") @db.VarChar(20)
  personName   String   @map("person_name") @db.VarChar(100)
  amount       Decimal  @db.Decimal(15, 2)
  amountPaid   Decimal  @default(0) @map("amount_paid") @db.Decimal(15, 2)
  currencyCode String   @map("currency_code") @db.VarChar(3)
  dueDate      DateTime @map("due_date") @db.Timestamptz(6)
  status       String   @default("PENDING") @db.VarChar(20)
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@map("loans")
}

// Credit Cards
model CreditCard {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String?   @map("account_id") @db.Uuid
  name                  String    @db.VarChar(100)
  lastFourDigits        String    @map("last_four_digits") @db.VarChar(4)
  creditLimit           Decimal   @map("credit_limit") @db.Decimal(15, 2)
  usedBalance           Decimal   @default(0) @map("used_balance") @db.Decimal(15, 2)
  closingDay            Int       @map("closing_day")
  paymentDueDay         Int       @map("payment_due_day")
  currencyCode          String    @map("currency_code") @db.VarChar(3)
  cardNetwork           String?   @map("card_network") @db.VarChar(20)
  expiryDate            DateTime? @map("expiry_date") @db.Timestamptz(6)
  interestRateAnnual    Decimal?  @map("interest_rate_annual") @db.Decimal(5, 2)
  interestRateMonthly   Decimal?  @map("interest_rate_monthly") @db.Decimal(5, 2)
  minPaymentPercent     Decimal   @default(5) @map("min_payment_percent") @db.Decimal(5, 2)
  minPaymentAbsolute    Decimal?  @map("min_payment_absolute") @db.Decimal(15, 2)
  color                 String    @default("#ef4444") @db.VarChar(20)
  icon                  String    @default("credit-card") @db.VarChar(50)
  isActive              Boolean   @default(true) @map("is_active")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         Profile              @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account?             @relation(fields: [accountId], references: [id], onDelete: SetNull)
  liquidations Liquidation[]
  transactions Transaction[]
  statements   CreditCardStatement[]

  @@index([userId])
  @@index([accountId])
  @@map("credit_cards")
}

// Credit Card Statements (Monthly Billing Cycles)
model CreditCardStatement {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  creditCardId          String   @map("credit_card_id") @db.Uuid
  statementMonth        Int      @map("statement_month")
  statementYear         Int      @map("statement_year")
  closingDate           DateTime @map("closing_date") @db.Timestamptz(6)
  dueDate               DateTime @map("due_date") @db.Timestamptz(6)
  openingBalance        Decimal  @default(0) @map("opening_balance") @db.Decimal(15, 2)
  totalPurchases        Decimal  @default(0) @map("total_purchases") @db.Decimal(15, 2)
  totalPayments         Decimal  @default(0) @map("total_payments") @db.Decimal(15, 2)
  totalInterest         Decimal  @default(0) @map("total_interest") @db.Decimal(15, 2)
  closingBalance        Decimal  @default(0) @map("closing_balance") @db.Decimal(15, 2)
  minimumPayment        Decimal  @default(0) @map("minimum_payment") @db.Decimal(15, 2)
  isPaid                Boolean  @default(false) @map("is_paid")
  paidAmount            Decimal  @default(0) @map("paid_amount") @db.Decimal(15, 2)
  paidDate              DateTime? @map("paid_date") @db.Timestamptz(6)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       Profile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditCard CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)

  @@unique([creditCardId, statementMonth, statementYear])
  @@index([userId])
  @@index([creditCardId])
  @@index([dueDate])
  @@map("credit_card_statements")
}

// Liquidations (Credit Card Payment Plans)
model Liquidation {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  creditCardId    String   @map("credit_card_id") @db.Uuid
  totalAmount     Decimal  @map("total_amount") @db.Decimal(15, 2)
  amountPaid      Decimal  @default(0) @map("amount_paid") @db.Decimal(15, 2)
  installments    Int
  startDate       DateTime @map("start_date") @db.Timestamptz(6)
  status          String   @default("ACTIVE") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       Profile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditCard CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("liquidations")
}

// Recurring Rules (for subscriptions and scheduled transactions)
model RecurringRule {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  accountId         String   @map("account_id") @db.Uuid
  transactionType   String   @map("transaction_type") @db.VarChar(50)
  amount            Decimal  @db.Decimal(15, 2)
  frequency         String   @db.VarChar(20)
  startDate         DateTime @map("start_date") @db.Timestamptz(6)
  endDate           DateTime? @map("end_date") @db.Timestamptz(6)
  description       String?  @db.VarChar(255)
  isActive          Boolean  @default(true) @map("is_active")
  lastExecutedDate  DateTime? @map("last_executed_date") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  expenseCategoryId String?  @map("expense_category_id") @db.Uuid
  incomeCategoryId  String?  @map("income_category_id") @db.Uuid
  subcategoryId     String?  @map("subcategory_id") @db.Uuid

  user            Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expenseCategory ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id], onDelete: SetNull)
  incomeCategory  IncomeCategory?  @relation(fields: [incomeCategoryId], references: [id], onDelete: SetNull)
  subcategory     Subcategory?     @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  transactions    Transaction[]

  @@index([userId])
  @@map("recurring_rules")
}

// ==========================================
// PETTY CASH FUND MANAGEMENT SYSTEM
// Sistema de Control de Caja Chica con Fondo Fijo
// ==========================================

// Petty Cash Fixed Funds (Fondos Fijos de Caja Chica)
model PettyCashFund {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  accountId         String   @map("account_id") @db.Uuid
  fundCode          String   @unique @map("fund_code") @db.VarChar(50) // e.g., "FF-2025-001"
  fundName          String   @map("fund_name") @db.VarChar(200)
  assignedAmount    Decimal  @map("assigned_amount") @db.Decimal(15, 2)
  currentBalance    Decimal  @map("current_balance") @db.Decimal(15, 2)
  currencyCode      String   @map("currency_code") @db.VarChar(3)
  responsibleName   String   @map("responsible_name") @db.VarChar(200)
  responsibleId     String?  @map("responsible_id") @db.VarChar(50) // DNI, Employee ID, etc.
  department        String?  @db.VarChar(100)
  description       String?  @db.Text
  status            String   @default("ACTIVE") @db.VarChar(20) // ACTIVE, SUSPENDED, CLOSED
  settlementThreshold Decimal @default(70) @map("settlement_threshold") @db.Decimal(5, 2) // % threshold for settlement
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  closedAt          DateTime? @map("closed_at") @db.Timestamptz(6)

  user          Profile                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  account       Account                 @relation(fields: [accountId], references: [id], onDelete: Restrict)
  expenses      PettyCashExpense[]
  settlements   PettyCashSettlement[]
  replenishments PettyCashReplenishment[]
  audits        PettyCashAudit[]
  transfersFrom PettyCashTransfer[]     @relation("TransferFrom")
  transfersTo   PettyCashTransfer[]     @relation("TransferTo")

  @@index([userId])
  @@index([accountId])
  @@index([status])
  @@map("petty_cash_funds")
}

// Petty Cash Expenses (Gastos de Caja Chica)
model PettyCashExpense {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  fundId            String   @map("fund_id") @db.Uuid
  settlementId      String?  @map("settlement_id") @db.Uuid
  expenseCode       String   @unique @map("expense_code") @db.VarChar(50) // Auto-generated
  expenseDate       DateTime @map("expense_date") @db.Timestamptz(6)
  amount            Decimal  @db.Decimal(15, 2)
  categoryId        String?  @map("category_id") @db.Uuid
  description       String   @db.VarChar(500)
  vendor            String?  @db.VarChar(200) // Proveedor
  receiptNumber     String?  @map("receipt_number") @db.VarChar(100) // Nº Comprobante
  receiptType       String?  @map("receipt_type") @db.VarChar(50) // Boleta, Factura, Recibo
  taxableAmount     Decimal? @map("taxable_amount") @db.Decimal(15, 2)
  taxAmount         Decimal? @map("tax_amount") @db.Decimal(15, 2)
  attachmentUrl     String?  @map("attachment_url") @db.Text // Document scan/photo
  justification     String?  @db.Text // Sustento del gasto
  status            String   @default("PENDING") @db.VarChar(20) // PENDING, APPROVED, REJECTED, SETTLED
  approvedBy        String?  @map("approved_by") @db.VarChar(200)
  approvedAt        DateTime? @map("approved_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        Profile              @relation(fields: [userId], references: [id], onDelete: Cascade)
  fund        PettyCashFund        @relation(fields: [fundId], references: [id], onDelete: Cascade)
  settlement  PettyCashSettlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  category    ExpenseCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory Subcategory?         @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  subcategoryId String?            @map("subcategory_id") @db.Uuid

  @@index([userId])
  @@index([fundId])
  @@index([settlementId])
  @@index([expenseDate])
  @@map("petty_cash_expenses")
}

// Petty Cash Settlements (Liquidaciones de Caja Chica)
model PettyCashSettlement {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  fundId            String   @map("fund_id") @db.Uuid
  settlementCode    String   @unique @map("settlement_code") @db.VarChar(50) // e.g., "LIQ-2025-001234"
  settlementDate    DateTime @map("settlement_date") @db.Timestamptz(6)
  totalAmount       Decimal  @map("total_amount") @db.Decimal(15, 2)
  expenseCount      Int      @map("expense_count")
  responsibleName   String   @map("responsible_name") @db.VarChar(200)
  receivedBy        String?  @map("received_by") @db.VarChar(200) // Finance person who received
  notes             String?  @db.Text
  status            String   @default("PENDING") @db.VarChar(20) // PENDING, APPROVED, REJECTED, ACCOUNTED
  approvedBy        String?  @map("approved_by") @db.VarChar(200)
  approvedAt        DateTime? @map("approved_at") @db.Timestamptz(6)
  accountedBy       String?  @map("accounted_by") @db.VarChar(200) // Contabilizado por
  accountedAt       DateTime? @map("accounted_at") @db.Timestamptz(6)
  accountingCode    String?  @map("accounting_code") @db.VarChar(50) // e.g., "10000234"
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          Profile                @relation(fields: [userId], references: [id], onDelete: Cascade)
  fund          PettyCashFund          @relation(fields: [fundId], references: [id], onDelete: Cascade)
  expenses      PettyCashExpense[]
  replenishment PettyCashReplenishment?

  @@index([userId])
  @@index([fundId])
  @@index([settlementDate])
  @@index([status])
  @@map("petty_cash_settlements")
}

// Petty Cash Replenishments (Reposiciones de Fondo Fijo)
model PettyCashReplenishment {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  fundId            String   @map("fund_id") @db.Uuid
  settlementId      String   @unique @map("settlement_id") @db.Uuid
  replenishmentCode String   @unique @map("replenishment_code") @db.VarChar(50) // e.g., "FF-2025-234"
  replenishmentDate DateTime @map("replenishment_date") @db.Timestamptz(6)
  amount            Decimal  @db.Decimal(15, 2)
  paymentMethod     String   @map("payment_method") @db.VarChar(50) // CASH, TRANSFER, CHECK
  referenceNumber   String?  @map("reference_number") @db.VarChar(100) // Transfer/check number
  approvedBy        String   @map("approved_by") @db.VarChar(200)
  deliveredBy       String?  @map("delivered_by") @db.VarChar(200) // Finance person who delivered
  receivedBy        String   @map("received_by") @db.VarChar(200) // Fund responsible who received
  notes             String?  @db.Text
  status            String   @default("PENDING") @db.VarChar(20) // PENDING, DELIVERED, CONFIRMED
  deliveredAt       DateTime? @map("delivered_at") @db.Timestamptz(6)
  confirmedAt       DateTime? @map("confirmed_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       Profile             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fund       PettyCashFund       @relation(fields: [fundId], references: [id], onDelete: Cascade)
  settlement PettyCashSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([fundId])
  @@index([settlementId])
  @@index([replenishmentDate])
  @@map("petty_cash_replenishments")
}

// Petty Cash Audits (Arqueos de Caja Chica)
model PettyCashAudit {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  fundId            String   @map("fund_id") @db.Uuid
  auditCode         String   @unique @map("audit_code") @db.VarChar(50) // e.g., "ARQ-2025-001"
  auditDate         DateTime @map("audit_date") @db.Timestamptz(6)
  auditType         String   @map("audit_type") @db.VarChar(50) // SCHEDULED, SURPRISE, ANNUAL
  expectedCash      Decimal  @map("expected_cash") @db.Decimal(15, 2)
  actualCash        Decimal  @map("actual_cash") @db.Decimal(15, 2)
  variance          Decimal  @map("variance") @db.Decimal(15, 2) // Diferencia
  pendingExpenses   Decimal  @map("pending_expenses") @db.Decimal(15, 2)
  auditedBy         String   @map("audited_by") @db.VarChar(200) // Auditor name
  responsiblePresent Boolean @map("responsible_present") // ¿Estuvo presente el responsable?
  findings          String?  @db.Text // Hallazgos
  recommendations   String?  @db.Text // Recomendaciones
  attachmentUrl     String?  @map("attachment_url") @db.Text // Acta de arqueo
  status            String   @default("COMPLETED") @db.VarChar(20) // COMPLETED, PENDING_RESPONSE, CLOSED
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  fund PettyCashFund @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([fundId])
  @@index([auditDate])
  @@map("petty_cash_audits")
}

// Petty Cash Transfers (Transferencias Provisionales de Fondo)
model PettyCashTransfer {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  fromFundId        String   @map("from_fund_id") @db.Uuid
  toResponsibleName String   @map("to_responsible_name") @db.VarChar(200)
  toResponsibleId   String?  @map("to_responsible_id") @db.VarChar(50)
  transferCode      String   @unique @map("transfer_code") @db.VarChar(50) // e.g., "TRF-2025-001"
  transferDate      DateTime @map("transfer_date") @db.Timestamptz(6)
  amount            Decimal  @db.Decimal(15, 2)
  transferType      String   @map("transfer_type") @db.VarChar(50) // PARTIAL, TOTAL, TEMPORARY
  reason            String   @db.Text
  receiptNumber     String?  @map("receipt_number") @db.VarChar(100) // Recibo provisional
  returnDate        DateTime? @map("return_date") @db.Timestamptz(6) // Fecha de devolución
  status            String   @default("PENDING") @db.VarChar(20) // PENDING, DELIVERED, RETURNED, CANCELLED
  deliveredBy       String?  @map("delivered_by") @db.VarChar(200)
  receivedBy        String?  @map("received_by") @db.VarChar(200)
  returnedAt        DateTime? @map("returned_at") @db.Timestamptz(6)
  notes             String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromFund PettyCashFund @relation("TransferFrom", fields: [fromFundId], references: [id], onDelete: Cascade)
  toFund   PettyCashFund? @relation("TransferTo", fields: [toResponsibleId], references: [fundCode], onDelete: SetNull)

  @@index([userId])
  @@index([fromFundId])
  @@index([transferDate])
  @@index([status])
  @@map("petty_cash_transfers")
}

// ==========================================
// SMART CATEGORIZATION SYSTEM
// ==========================================

model CategoryLearning {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  keyword       String   @db.VarChar(200)
  categoryId    String   @map("category_id") @db.Uuid
  confidence    Decimal  @default(1.0) @db.Decimal(3, 2)
  timesUsed     Int      @default(1) @map("times_used")
  lastUsedAt    DateTime @default(now()) @map("last_used_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategory Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  subcategoryId String? @map("subcategory_id") @db.Uuid

  @@unique([userId, keyword, categoryId])
  @@index([userId])
  @@index([keyword])
  @@map("category_learning")
}

// ==========================================
// MULTI-CURRENCY SYSTEM
// ==========================================

model Currency {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(3)
  name      String   @db.VarChar(100)
  symbol    String   @db.VarChar(10)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("currencies")
}

model ExchangeRate {
  id           String   @id @default(uuid()) @db.Uuid
  fromCurrency String   @map("from_currency") @db.VarChar(3)
  toCurrency   String   @map("to_currency") @db.VarChar(3)
  rate         Decimal  @db.Decimal(18, 8)
  date         DateTime @db.Timestamptz(6)
  source       String?  @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([fromCurrency, toCurrency, date])
  @@index([fromCurrency, toCurrency])
  @@index([date])
  @@map("exchange_rates")
}

model GoogleToken {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  accessToken  String   @map("access_token") @db.Text
  refreshToken String?  @map("refresh_token") @db.Text
  expiryDate   DateTime @map("expiry_date") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_tokens")
}
